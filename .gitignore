# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Project outputs
boltz_results_*/
l1_budget_gate_*/
l1_budget_gate_*.log
binder/
out_binder/
eval_data/
generated/
msa/
mgtbind_inputs/
tests/random_protein_sweep/
# local scratch batch for ESMFold2 runs (not repo content)
prot8/

# ...but keep the committed BoltzGen reference fixtures (the binder/ rule above would hide them)
!docs/implementation-parity-data/ref-fixtures/boltzgen/binder/
!docs/implementation-parity-data/ref-fixtures/boltzgen/binder/**

# ...and keep vendored packages that happen to be named after an output directory.
# The msa/ rule above is for MSA output caches, but atomworks ships
# ml/preprocessing/msa/ and ml/transforms/msa/. Without this, they are dropped
# silently at commit and RF3 dies with ModuleNotFoundError on a clean checkout.
!tt_bio/_vendor/**/msa/
!tt_bio/_vendor/**/msa/**

# Parity reference fixtures: externalize the large binaries (CIF structures, A3M
# MSAs, NPZ coordinate tensors) to GitHub Release assets and fetch on demand
# (scripts/fetch_parity_fixtures.sh). The small provenance JSONs/yaml/csv stay
# committed (they are the evidence a reader checks); ignore new .cif/.a3m/.npz so
# they are not accidentally re-added to git. The already-committed fixtures stay
# tracked (no history rewrite); this only blocks future binary additions.
docs/implementation-parity-data/ref-fixtures/**/*.cif
docs/implementation-parity-data/ref-fixtures/**/*.a3m
docs/implementation-parity-data/ref-fixtures/**/*.npz

# Same rationale: the AbAg-XM seeds-vs-samples-oracle-frontier research merge (07-31)
# added ~25MB of ground-truth CIFs here in a second, previously-unguarded location.
# Already-committed ones stay tracked (no history rewrite); block further growth.
examples/ground_truth_structures/*.cif

# ...but keep the vendored ESM MSA package (the msa/ rule above would hide it)
!tt_bio/_vendor/esm/utils/msa/
!tt_bio/_vendor/esm/utils/msa/*.py

# MGTBind artifacts (regenerated by mgtbind/prepare.py and evaluate.py)
mgtbind_inputs/
mgtbind/sample.csv
mgtbind/comparison.csv

# IDE
.vscode/
.idea/

# Test cache
.pytest_cache/
test_16/
*.log
memory_inputs/
oom_inputs/

.perf-runs/
perf/p2/

# planning/status/coordination notes belong in the coworker system, not the repo
/notes/

# RFD3 port local scratch (goldens, foundry clone, ckpt) - not repo content
.scratch/
.msa_zsilu/
.msa_ab512_*/
.msa_ab/

# Benchmark scratch belongs under perf/<task>/, never in the repo root. Four run_*.sh
# from the of3sizes pass were committed to root and merged (2026-08-13); this stops a repeat.
/run_*.sh
/bench_*.sh
/ab_*.sh
scratch/
.msa_px4pd_*/
.msa_tokenbucket/

# Correctness-sweep embedding artifacts: one .npz per sequence, and the cap cells are
# 50 sequences x 2000 residues x d_model float32 each -- 1.3 GB across five models. The
# evidence is the per-artifact .check.json and results/matrix.jsonl, both of which stay;
# the raw tensors are reproducible with `matrix.py --run --group embed`.
perf/wh-correctness/results/artifacts/**/*.npz
perf/wh-correctness/results/artifacts/**/*.parquet

# wrangler local cache
.wrangler/

# size-ladder gate scratch (folds + censuses); the baseline evidence is perf/sizegate/baseline/
perf/sizegate/work/

# Never again: press/pmol-env was a committed virtualenv (~976 MB of this
# repo's history) and landing-page video added ~70 MB more. tests/test_repo_size_guard.py
# enforces this; these patterns stop it reaching the index in the first place.
*.dylib
*.dll
*.whl
site-packages/
node_modules/
/press/
*.mp4
*.webm
*.mov

# The !tt_bio/_vendor/**/msa/** re-include near the top also un-ignores __pycache__ under those
# directories, so any worktree that has imported the vendored ESM carries an untracked dir and
# merge_preflight.sh reads DIRTY on it. Re-ignore the bytecode; the sources stay included.
tt_bio/_vendor/**/__pycache__/
