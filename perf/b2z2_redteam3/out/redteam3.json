    "host_seconds_asymmetry": {
      "tt_host_inside_cell": true,
      "h200_host_s": 0.24,
      "h200_host_in_cell": false,
      "page_says": "Two readings of the same eight rows. Whole fold counts every second a user waits for on both sides. Device only strips the host work off both sides, and it is the reading that says what the silicon does. The Tenstorrent host seconds are inside the published cell on every row; the NVIDIA ones sit outside it on the five folding rows and inside it on RoseTTAFold3, PXDesign and Nesso-1, whose cells time host and device together. Every Tenstorrent host figure is an upper bound, so every device-only ratio here is a lower bound on the real device gap. This table is Blackhole against H200 only."
    },
    "timed_region_note": "Each cell times what that platform's own harness times, and the regions are not identical: every Tenstorrent number is a whole prediction call with featurisation and structure writing inside it, and on NVIDIA that is true of RoseTTAFold3 and effectively true of ESMFold2, but the Boltz-2, OpenFold3, Protenix-v2 and OpenDDE cells time the network forward and leave host work outside the timer. What they leave out is 0.24 s, 0.43 s, 0.62 s and 6.31 s per prediction, which makes those four ratios larger than a like-for-like comparison would. The host and device table gives both readings for every row.",
    "verdict_inputs": {
      "same_fixture": true,
      "same_protocol": true,
      "tt_cell_includes_host_seconds": true,
      "h200_cell_excludes_its_0_24_s_host": true
    }
  }
