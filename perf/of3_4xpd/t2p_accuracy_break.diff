diff --git a/tt_bio/tenstorrent.py b/tt_bio/tenstorrent.py
index 05bb4010..cfb98bdc 100644
--- a/tt_bio/tenstorrent.py
+++ b/tt_bio/tenstorrent.py
@@ -365,6 +365,30 @@ def _no_host_pad(x: ttnn.Tensor, dtype, n: int, n_pad: int) -> ttnn.Tensor | Non
     return x if x.dtype == dtype else ttnn.typecast(x, dtype)
 
 
+def _device_pad(x: ttnn.Tensor, dtype, n: int, n_pad: int) -> ttnn.Tensor | None:
+    """``x`` zero-padded from ``n`` to ``n_pad`` along dim -2 on device, or None when the
+    host round trip is still needed.
+
+    The atom dim is 4116 at 512 aa and rounds to 4128, so ``_no_host_pad`` declines and
+    the helper falls back to untilize -> host torch pad -> re-tilize, 1.8 ms per
+    diffusion step, 0.37 s over the 200-step rollout with the device idle for all of it.
+    ``ttnn.pad`` writes the same zeros in the same places; the real rows are copied, not
+    recomputed, so the result is bit-identical.
+    """
+    if x.layout != ttnn.TILE_LAYOUT or n_pad <= n or int(x.shape[-2]) != n:
+        return None
+    try:
+        pad = [(0, 0)] * (len(x.shape) - 2) + [(0, n_pad - n), (0, 0)]
+        y = ttnn.pad(x, pad, value=0.0)
+    except (RuntimeError, TypeError):
+        return None
+    if y.dtype != dtype:
+        z = ttnn.typecast(y, dtype)
+        ttnn.deallocate(y)
+        y = z
+    return y
+
+
