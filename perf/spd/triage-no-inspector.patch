@@ -160,6 +160,41 @@
 # TODO: parse_inspector_logs types should have different field names and different return types (not dictionary, but named tuple with array of elements)
 
 
+class NoInspector:
+    """Stand-in for a process that ran with TT_METAL_INSPECTOR=0 (jf-abag-hang).
+
+    Answers only what dispatcher_data needs to decode mailboxes: the device list and a firmware path
+    (TRIAGE_NO_INSPECTOR_FW). No programs and no kernel ids, so dispatcher_data names kernels by matching
+    L1 text against the kernel cache (TRIAGE_KERNEL_CACHE)."""
+
+    def __init__(self, context, firmware_path):
+        from types import SimpleNamespace as ns
+
+        ids = list(context.devices.keys())
+        self._ns, self._ids, self._context, self._fw = ns, ids, context, firmware_path
+
+    def getMetalDeviceIdMappings(self):
+        return self._ns(mappings=[self._ns(metalDeviceId=i, uniqueId=self._context.devices[i].unique_id) for i in self._ids])
+
+    def getDevicesInUse(self):
+        return self._ns(metalDeviceIds=self._ids)
+
+    def getBlocksByType(self):
+        return self._ns(chips=[self._ns(chipId=i, blocks=self._ns(idleEth=[], activeEth=[])) for i in self._ids])
+
+    def getAllBuildEnvs(self):
+        return self._ns(buildEnvs=[self._ns(metalDeviceId=i, buildInfo=self._ns(firmwarePath=self._fw)) for i in self._ids])
+
+    def getPrograms(self):
+        return self._ns(programs=[])
+
+    def getKernel(self, watcher_kernel_id):
+        raise KeyError(watcher_kernel_id)
+
+    def stop(self):
+        pass
+
+
