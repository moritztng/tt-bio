+_kernel_text_index: dict[str, list[tuple[bytes, str]]] | None = None
+TEXT_PROBE = 64
+
+
+def match_cached_kernel(location: OnChipCoordinate, proc_name: str, text_addr: int):
+    """Name a kernel without Inspector: the first TEXT_PROBE bytes of its text in L1 equal those of exactly one
+    `<cache>/kernels/<name>/<hash>/<risc>/<risc>.elf.xip.elf` (TRIAGE_KERNEL_CACHE, ':'-separated roots), looked up
+    in the kit's prebuilt kernel_text_index.pkl (TRIAGE_KERNEL_INDEX = its directory; parsing the cache live is too slow)."""
+    global _kernel_text_index
+    roots, kit = os.environ.get("TRIAGE_KERNEL_CACHE"), os.environ.get("TRIAGE_KERNEL_INDEX")
+    proc = proc_name.lower()
+    if not roots or not kit or proc == "ncrisc":  # Wormhole NCRISC runs from IRAM with no XIP ELF
+        return None
+    if _kernel_text_index is None:
+        import sys
+
+        sys.path.insert(0, kit)
+        import kernel_text_index
+
+        if not kernel_text_index.INDEX.exists():
+            return None
+        _kernel_text_index = kernel_text_index.load(roots)
+    from ttexalens.tt_exalens_lib import read_from_device
+
+    try:
+        l1 = bytes(read_from_device(location, text_addr, num_bytes=TEXT_PROBE))
+    except Exception:
+        return None
+    hits = sorted({x for text, x in _kernel_text_index.get(proc, []) if l1.startswith(text)})
+    if not hits:
+        return None
+    from types import SimpleNamespace
+
+    hash_dir = os.path.dirname(os.path.dirname(hits[0]))
+    name = os.path.basename(os.path.dirname(hash_dir))
+    if len(hits) > 1:
+        name += f" (+{len(hits) - 1} same-text)"
+    return SimpleNamespace(path=hash_dir, name=name, watcherKernelId=-1, programId=-1)
+
+
