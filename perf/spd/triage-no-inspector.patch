+_kernel_text_index: dict[str, list[tuple[bytes, str]]] | None = None
+TEXT_PROBE = 64
+
+
+def _xip_text(path: str) -> bytes | None:
+    from elftools.elf.elffile import ELFFile
+
+    with open(path, "rb") as f:
+        sec = ELFFile(f).get_section_by_name(".text")
+        return sec.data()[:TEXT_PROBE] if sec is not None else None
+
+
+def match_cached_kernel(location: OnChipCoordinate, proc_name: str, text_addr: int):
+    """Name a kernel without Inspector: the first TEXT_PROBE bytes of its text in L1 equal those of exactly one
+    `<cache>/kernels/<name>/<hash>/<risc>/<risc>.elf.xip.elf` (TRIAGE_KERNEL_CACHE, ':'-separated roots)."""
+    global _kernel_text_index
+    roots = os.environ.get("TRIAGE_KERNEL_CACHE")
+    proc = proc_name.lower()
+    if not roots or proc == "ncrisc":  # Wormhole NCRISC runs from IRAM with no XIP ELF
+        return None
+    if _kernel_text_index is None:
+        import glob
+
+        _kernel_text_index = {}
+        for root in roots.split(":"):
+            for xip in glob.glob(os.path.join(root, "**/kernels/*/*/*/*.elf.xip.elf"), recursive=True):
+                try:
+                    text = _xip_text(xip)
+                except Exception:
+                    continue
+                if text:
+                    _kernel_text_index.setdefault(os.path.basename(os.path.dirname(xip)), []).append((text, xip))
+    from ttexalens.tt_exalens_lib import read_from_device
+
+    try:
+        l1 = bytes(read_from_device(location, text_addr, num_bytes=TEXT_PROBE))
+    except Exception:
+        return None
+    hits = sorted({x for text, x in _kernel_text_index.get(proc, []) if l1.startswith(text)})
+    if not hits:
+        return None
+    from types import SimpleNamespace
+
+    hash_dir = os.path.dirname(os.path.dirname(hits[0]))
+    name = os.path.basename(os.path.dirname(hash_dir))
+    if len(hits) > 1:
+        name += f" (+{len(hits) - 1} same-text)"
+    return SimpleNamespace(path=hash_dir, name=name, watcherKernelId=-1, programId=-1)
+
+
