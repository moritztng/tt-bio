+DESIGN_MODEL_FACTORIES: dict = {}
+
+def register_design_model(name: str, factory) -> None:
+    #a package that implements DifferentiableProteinPredictor registers itself here at import time
+    DESIGN_MODEL_FACTORIES[name] = factory
+
+def design_model_factory(settings: dict):
+    #the callable that builds the design and validation predictors; AlphaFoldDesignModel unless a campaign asks for another
+    name = settings.get('design_model')
+    if not name or name == 'alphafold2':
+        return AlphaFoldDesignModel
+    if name not in DESIGN_MODEL_FACTORIES:
+        raise ValueError(f"unknown design_model {name!r}: registered models are {sorted(DESIGN_MODEL_FACTORIES) or 'none'}")
+    return DESIGN_MODEL_FACTORIES[name]
+
