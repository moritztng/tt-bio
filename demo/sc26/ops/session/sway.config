# SC26 booth session: one full-screen browser and nothing else. No bar, no key bindings, so a
# visitor cannot close or move anything. The background is a still of a real fold, so even the
# second a browser restarts the screen is never blank.
output * bg @OPS@/session/poster.png fill #05070b
default_border none
default_floating_border none
focus_follows_mouse no
seat * hide_cursor 2500
# A starting browser commits a black buffer, then its own toolbar and a grey window, about half a
# second before the page. Sway draws a fullscreen window over black, not over the poster, so every
# new window starts tiled and transparent (the poster shows through) and goes fullscreen only once
# the app has set its title. A Firefox error page never matches, so it never shows either.
for_window [app_id=".*"] fullscreen disable, opacity 0
for_window [title="^TT-Bio"] opacity 1, fullscreen enable
output HEADLESS-1 mode 1920x1080
exec @OPS@/session/display.sh
# The demo's clients connect through wayland-sc26, a hard link to sway's own socket: a shared
# test box once lost its numbered wayland-N to a co-tenant's cleanup and the soak went blind.
exec sh -c 'ln -f "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" "$XDG_RUNTIME_DIR/wayland-sc26"; export WAYLAND_DISPLAY=wayland-sc26; systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP; dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP; systemctl --user start sc26.target'
