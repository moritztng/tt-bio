# SC26 booth session: one full-screen browser and nothing else. No bar, no key bindings, so a
# visitor cannot close or move anything. The background is a still of a real fold, so even the
# second a browser restarts the screen is never blank.
output * bg @OPS@/session/poster.png fill #05070b
default_border none
default_floating_border none
focus_follows_mouse no
seat * hide_cursor 2500
for_window [app_id=".*"] fullscreen enable
exec sh -c 'systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP; dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP; systemctl --user start sc26.target'
