[Unit]
Description=SC26 booth demo: the fold service on the chips
PartOf=sc26.target

[Service]
EnvironmentFile=-%h/.config/sc26/env
ExecStart=@OPS@/engine.sh
ExecStopPost=@PY@ @OPS@/leases.py release 0,1,2,3
Restart=always
RestartSec=3
# SIGINT lets a worker drop its fold and close its chip cleanly; a SIGKILLed worker leaves the
# chip dirty, so systemd never sends one.
KillSignal=SIGINT
TimeoutStopSec=90
SendSIGKILL=no
Nice=5

[Install]
WantedBy=default.target
