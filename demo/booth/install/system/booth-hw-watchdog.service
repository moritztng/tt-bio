[Unit]
Description=TT-Bio booth: make systemd feed the board's hardware watchdog
# Not After=multi-user.target: on a QuietBox that target can wait on plymouth indefinitely.
After=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/booth-arm-hw-watchdog.sh

[Install]
WantedBy=multi-user.target
