#!/usr/bin/env bash
# Start, stop and install the TT-Bio booth demo on qb2.
#
#   boothctl start | stop | restart     the demo (engine, kiosk browser, watchdog)
#   boothctl health                     HEALTHY or not, in plain words (exit 1 when not)
#   boothctl status                     units, chips, and the last watchdog line
#   boothctl logs                       follow every demo unit's journal
#   boothctl video [file]               the fallback: the recorded loop, full screen, on repeat
#   boothctl units                      install the user units only (no boot change)
#   boothctl install                    boot straight into the demo (needs sudo once)
#   boothctl uninstall                  back to the normal Ubuntu login
#
# Nothing here powers the box off or reboots it. After install, one press of the power button
# reboots into the demo; powering off stays impossible.
set -euo pipefail
ops=$(cd "$(dirname "$0")" && pwd)
cfg=$HOME/.config/booth
# The settings file the units read, so that health and status use the engine's own Python.
if [ -f "$cfg/env" ]; then set -a; . "$cfg/env"; set +a; fi
py=${BOOTH_PYTHON:-$HOME/tt-bio-dev/env/bin/python3}
units=(booth-engine.service booth-kiosk.service booth-watchdog.service booth.target)
udir=$HOME/.config/systemd/user
bak=$HOME/booth-logs/install-backup

render(){ sed -e "s|@OPS@|$ops|g" -e "s|@PY@|$py|g" -e "s|@CFG@|$cfg|g" "$1"; }

install_user(){
  mkdir -p "$udir" "$HOME/booth-logs" "$HOME/.config/booth"
  for u in "${units[@]}"; do render "$ops/units/$u" > "$udir/$u"; done
  render "$ops/session/sway.config" > "$cfg/sway.config"
  render "$ops/session/session.sh" > "$cfg/session.sh.new"; chmod +x "$cfg/session.sh.new"
  mv "$cfg/session.sh.new" "$cfg/session.sh"   # a new file: the running session keeps reading its own
  [ -f "$HOME/.config/booth/env" ] || printf '%s\n' \
    '# BOOTH_CHIPS=0,1,2,3 at the booth. Empty: replay only, no chip taken (development).' \
    'BOOTH_CHIPS=' > "$HOME/.config/booth/env"
  systemctl --user daemon-reload
  systemctl --user enable booth-engine.service
}

install_system(){
  mkdir -p "$bak"
  sudo cp -n /etc/gdm3/custom.conf "$bak/custom.conf" 2>/dev/null || true
  sudo cp -n /var/lib/AccountsService/users/"$USER" "$bak/accountsservice" 2>/dev/null || true
  render "$ops/session/booth.desktop" | sudo tee /usr/share/wayland-sessions/booth.desktop > /dev/null
  # Autologin into the booth session: no login prompt, and no GNOME, so no keyring or update dialog.
  sudo python3 - "$USER" <<'PY'
import configparser, sys
user = sys.argv[1]
p = "/etc/gdm3/custom.conf"
c = configparser.ConfigParser(strict=False, interpolation=None); c.optionxform = str
c.read(p)
c.setdefault("daemon", {})
c["daemon"]["AutomaticLoginEnable"] = "true"
c["daemon"]["AutomaticLogin"] = user
with open(p, "w") as f: c.write(f)
a = f"/var/lib/AccountsService/users/{user}"
c = configparser.ConfigParser(interpolation=None); c.optionxform = str
c.read(a)
c.setdefault("User", {})
c["User"]["Session"] = "booth"
c["User"]["XSession"] = ""
with open(a, "w") as f: c.write(f)
PY
  sudo install -D -m 644 "$ops/../web/app/kiosk/policies.json" /etc/firefox/policies/policies.json
  # One press of the power button reboots (a clean restart for the booth staff); poweroff stays masked.
  sudo install -D -m 644 "$ops/session/logind-booth.conf" /etc/systemd/logind.conf.d/booth-power-key.conf
  sudo systemctl kill -s HUP systemd-logind
  # No browser update and no package upgrade during the show.
  sudo snap refresh --hold=forever
  sudo systemctl disable --now unattended-upgrades.service apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
}

uninstall_system(){
  [ -f "$bak/custom.conf" ] && sudo cp "$bak/custom.conf" /etc/gdm3/custom.conf
  [ -f "$bak/accountsservice" ] && sudo cp "$bak/accountsservice" /var/lib/AccountsService/users/"$USER"
  sudo rm -f /usr/share/wayland-sessions/booth.desktop /etc/systemd/logind.conf.d/booth-power-key.conf
  sudo systemctl kill -s HUP systemd-logind
  sudo snap refresh --unhold || true
  sudo systemctl enable --now unattended-upgrades.service apt-daily.timer apt-daily-upgrade.timer || true
  systemctl --user disable booth-engine.service || true
}

case "${1:-}" in
  start) pkill -u "$USER" -f "mpv --title=booth-video" || true; systemctl --user start booth.target ;;
  stop) systemctl --user stop booth.target booth-engine.service booth-kiosk.service booth-watchdog.service ;;
  video)
    f=${2:-$HOME/booth-video/booth-loop.mp4}
    [ -f "$f" ] || { echo "no video at $f. Copy booth-loop-4k-h264.mp4 there (INSTALL.md, \"The fallback video\")."; exit 1; }
    sock=$(ls -t "/run/user/$(id -u)"/sway-ipc.*.sock 2>/dev/null | head -n 1)
    [ -n "$sock" ] || { echo "the booth session is not on screen (no sway running). Reboot into it first."; exit 1; }
    systemctl --user stop booth.target booth-engine.service booth-kiosk.service booth-watchdog.service
    pkill -u "$USER" -f "mpv --title=booth-video" || true
    swaymsg -q -s "$sock" exec "mpv --title=booth-video --fs --loop-file=inf --no-audio --no-osc --osd-level=0 --no-input-default-bindings --hwdec=auto-safe --really-quiet '$f'"
    echo "The video is playing on the booth screen. '$0 start' goes back to the live demo." ;;
  restart) systemctl --user restart booth-engine.service booth-kiosk.service booth-watchdog.service ;;
  status)
    systemctl --user --no-pager status "${units[@]}" | grep -E '^[●○×] |Active:' || true
    port=${BOOTH_PORT:-$(sed -n 's/^BOOTH_PORT=//p' "$cfg/env" 2>/dev/null)}
    if st=$(curl -sf --max-time 3 "http://127.0.0.1:${port:-8626}/status"); then
      # an out-of-service chip carries no clock, so print the clock only where there is one
      "$py" -c 'import json,sys; s=json.load(sys.stdin); print("chips:", " ".join("%s:%s%s" % (c["chip"], c["state"], "@%s" % c["aiclk_mhz"] if c.get("aiclk_mhz") else "") for c in s["chips"]) or "none (replay only)", "| queue", s["queue"])' <<< "$st"
    else
      echo "engine: not answering"
    fi
    tail -n 1 "$HOME/booth-logs/watchdog.jsonl" 2>/dev/null || true ;;
  health) exec "$py" "$ops/health.py" ;;
  logs) journalctl --user -f -u 'booth-*' ;;
  units) install_user; echo "user units installed (no boot change)" ;;
  install) install_user; install_system; echo "installed: the next boot lands on the demo" ;;
  uninstall) systemctl --user stop booth.target || true; uninstall_system; echo "uninstalled" ;;
  *) sed -n '2,14p' "$0"; exit 2 ;;
esac
