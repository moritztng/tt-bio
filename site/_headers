# Cloudflare Pages edge caching. Every asset the HTML references carries a ?v=
# content stamp (scripts/stamp_assets.py), so a changed file is a changed URL and
# these can be cached hard without a deploy ever being invisible. The pages
# themselves carry no stamp, so they stay short.
/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/assets/*.webp
  Cache-Control: public, max-age=2592000
/assets/*.jpg
  Cache-Control: public, max-age=2592000
/assets/*.ico
  Cache-Control: public, max-age=31536000, immutable
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable
/assets/site.css
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: public, max-age=600
/*
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
