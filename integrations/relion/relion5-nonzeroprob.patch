+void HealpixSampling::buildNonZeroPriorCache()
+{
+	nzp_built = true;
+	nzp_usable = false;
+	nzp_dirx.clear();
+	nzp_diry.clear();
+	nzp_dirz.clear();
+	nzp_perm.clear();
+	nzp_sgn.clear();
+
+	// M_j = L_j R_j^T must be an exact signed permutation matrix for every operator, otherwise
+	// the cached loop is only algebraically equal to the original and not bit-identical.
+	const int nsym = R_repository.size();
+	std::vector<int> perm(3 * nsym, -1);
+	std::vector<RFLOAT> sgn(3 * nsym, 0.);
+	for (int j = 0; j < nsym; j++)
+	{
+		bool colused[3] = {false, false, false};
+		for (int a = 0; a < 3; a++)
+		{
+			int nz = 0;
+			for (int b = 0; b < 3; b++)
+			{
+				RFLOAT acc = 0.;
+				for (int k = 0; k < 3; k++)
+					acc += MAT_ELEM(L_repository[j], a, k) * MAT_ELEM(R_repository[j], b, k);
+				if (acc == 0.)
+					continue;
+				if (acc != 1. && acc != -1.)
+					return;             // not a signed permutation
+				if (colused[b])
+					return;             // two nonzeros in one column
+				colused[b] = true;
+				perm[3 * j + a] = b;
+				sgn[3 * j + a] = acc;
+				nz++;
+			}
+			if (nz != 1)
+				return;                 // row empty or with two nonzeros
+		}
+	}
+
+	const size_t n = rot_angles.size();
+	nzp_dirx.resize(n);
+	nzp_diry.resize(n);
+	nzp_dirz.resize(n);
+	for (size_t i = 0; i < n; i++)
+	{
+		Matrix1D<RFLOAT> v;
+		Euler_angles2direction(rot_angles[i], tilt_angles[i], v);
+		nzp_dirx[i] = XX(v);
+		nzp_diry[i] = YY(v);
+		nzp_dirz[i] = ZZ(v);
+	}
+	nzp_perm = perm;
+	nzp_sgn = sgn;
+	nzp_usable = true;
+}
